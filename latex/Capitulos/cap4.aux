\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Abundancia relativa de eucariotas por nivel taxonómico, con las muestras separadas por grupo y aglomeración al 10\%. A) Filo: Oomycota muestra una abundancia relativa ligeramente menor en las muestras no saludables. B) Familia: la misma tendencia en Peronosporaceae. C) Género: \textit  {Fusarium} y \textit  {Phytophthora} entre los géneros distinguibles. D) Especie. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260924_RegenerarBarrasEukarya47.R}{(Script: \texttt  {20260924\_RegenerarBarrasEukarya47.R})}}}{68}{figure.4.7}\protected@file@percent }
\newlabel{fig:barras-eukarya}{{4.7}{68}{Abundancia relativa de eucariotas por nivel taxonómico, con las muestras separadas por grupo y aglomeración al 10\%. A) Filo: Oomycota muestra una abundancia relativa ligeramente menor en las muestras no saludables. B) Familia: la misma tendencia en Peronosporaceae. C) Género: \textit {Fusarium} y \textit {Phytophthora} entre los géneros distinguibles. D) Especie. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260924_RegenerarBarrasEukarya47.R}{(Script: \texttt {20260924\_RegenerarBarrasEukarya47.R})}}{figure.4.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Diversidad alfa de los eucariotas por nivel taxonómico: A) filo, B) familia, C) género, D) especie. Las muestras saludables tienden a mayor riqueza observada y Chao1 en todos los niveles. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarAlphaEukarya48.R}{(Script: \texttt  {20260919\_RegenerarAlphaEukarya48.R})}}}{69}{figure.4.8}\protected@file@percent }
\newlabel{fig:alpha-eukarya}{{4.8}{69}{Diversidad alfa de los eucariotas por nivel taxonómico: A) filo, B) familia, C) género, D) especie. Las muestras saludables tienden a mayor riqueza observada y Chao1 en todos los niveles. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarAlphaEukarya48.R}{(Script: \texttt {20260919\_RegenerarAlphaEukarya48.R})}}{figure.4.8}{}}
