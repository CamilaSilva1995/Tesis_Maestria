\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}Prueba t sobre el índice de Shannon de la comunidad completa}{74}{subsection.4.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces Prueba t de Student sobre el índice de Shannon de la comunidad completa. A) Distribución del índice en cada grupo, con la media señalada por la línea punteada. B) Asumiendo varianzas iguales: $t = 1.939$, 51 grados de libertad, $p = 0.058$. C) Asumiendo varianzas distintas (Welch): $t = 1.499$, 19.3 grados de libertad, $p = 0.150$. En ambos casos el estadístico queda fuera de la región de rechazo y no se rechaza la hipótesis nula. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarTTestShannon413.R}{(Script: \texttt  {20260919\_RegenerarTTestShannon413.R})}}}{75}{figure.4.13}\protected@file@percent }
\newlabel{fig:ttest-shannon}{{4.13}{75}{Prueba t de Student sobre el índice de Shannon de la comunidad completa. A) Distribución del índice en cada grupo, con la media señalada por la línea punteada. B) Asumiendo varianzas iguales: $t = 1.939$, 51 grados de libertad, $p = 0.058$. C) Asumiendo varianzas distintas (Welch): $t = 1.499$, 19.3 grados de libertad, $p = 0.150$. En ambos casos el estadístico queda fuera de la región de rechazo y no se rechaza la hipótesis nula. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarTTestShannon413.R}{(Script: \texttt {20260919\_RegenerarTTestShannon413.R})}}{figure.4.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.3}Prueba t sobre el índice de Shannon de los géneros de eucariotas}{75}{subsection.4.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.14}{\ignorespaces Prueba t de Student sobre el índice de Shannon calculado a nivel de género en eucariotas (58 géneros, entre ellos \textit  {Fusarium}). A) Distribución del índice en cada grupo, con la media señalada por la línea punteada: 3.077 en el grupo saludable y 3.035 en el no saludable. B) Asumiendo varianzas iguales: $t = 1.139$, 51 grados de libertad, $p = 0.260$. C) Asumiendo varianzas distintas (Welch): $t = 0.902$, 20 grados de libertad, $p = 0.378$. En ambos casos el estadístico queda dentro de la región de no rechazo. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarTTestFusarium414.R}{(Script: \texttt  {20260919\_RegenerarTTestFusarium414.R})}}}{76}{figure.4.14}\protected@file@percent }
\newlabel{fig:ttest-eucariotas}{{4.14}{76}{Prueba t de Student sobre el índice de Shannon calculado a nivel de género en eucariotas (58 géneros, entre ellos \textit {Fusarium}). A) Distribución del índice en cada grupo, con la media señalada por la línea punteada: 3.077 en el grupo saludable y 3.035 en el no saludable. B) Asumiendo varianzas iguales: $t = 1.139$, 51 grados de libertad, $p = 0.260$. C) Asumiendo varianzas distintas (Welch): $t = 0.902$, 20 grados de libertad, $p = 0.378$. En ambos casos el estadístico queda dentro de la región de no rechazo. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarTTestFusarium414.R}{(Script: \texttt {20260919\_RegenerarTTestFusarium414.R})}}{figure.4.14}{}}
