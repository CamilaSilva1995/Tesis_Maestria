\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}Prueba t sobre el índice de Shannon de la comunidad completa}{54}{subsection.4.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces Prueba t de Student sobre el índice de Shannon de la comunidad completa. A) Distribución del índice en cada grupo, con la media señalada por la línea punteada. B) Asumiendo varianzas iguales: $t = 1.939$, 51 grados de libertad, $p = 0.058$. C) Asumiendo varianzas distintas (Welch): $t = 1.499$, 19.3 grados de libertad, $p = 0.150$. En ambos casos el estadístico queda fuera de la región de rechazo y no se rechaza la hipótesis nula.}}{55}{figure.4.12}\protected@file@percent }
\newlabel{fig:ttest-shannon}{{4.12}{55}{Prueba t de Student sobre el índice de Shannon de la comunidad completa. A) Distribución del índice en cada grupo, con la media señalada por la línea punteada. B) Asumiendo varianzas iguales: $t = 1.939$, 51 grados de libertad, $p = 0.058$. C) Asumiendo varianzas distintas (Welch): $t = 1.499$, 19.3 grados de libertad, $p = 0.150$. En ambos casos el estadístico queda fuera de la región de rechazo y no se rechaza la hipótesis nula}{figure.4.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.3}Prueba t sobre el índice de Shannon de los géneros de eucariotas}{55}{subsection.4.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces Prueba t de Student sobre el índice de Shannon calculado a nivel de género en eucariotas (58 géneros, entre ellos \textit  {Fusarium}). A) Distribución del índice en cada grupo, con la media señalada por la línea punteada: 3.077 en el grupo saludable y 3.035 en el no saludable. B) Asumiendo varianzas iguales: $t = 1.139$, 51 grados de libertad, $p = 0.260$. C) Asumiendo varianzas distintas (Welch): $t = 0.902$, 20 grados de libertad, $p = 0.378$. En ambos casos el estadístico queda dentro de la región de no rechazo. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarTTestFusarium413.R}{(Script)}}}{56}{figure.4.13}\protected@file@percent }
\newlabel{fig:ttest-eucariotas}{{4.13}{56}{Prueba t de Student sobre el índice de Shannon calculado a nivel de género en eucariotas (58 géneros, entre ellos \textit {Fusarium}). A) Distribución del índice en cada grupo, con la media señalada por la línea punteada: 3.077 en el grupo saludable y 3.035 en el no saludable. B) Asumiendo varianzas iguales: $t = 1.139$, 51 grados de libertad, $p = 0.260$. C) Asumiendo varianzas distintas (Welch): $t = 0.902$, 20 grados de libertad, $p = 0.378$. En ambos casos el estadístico queda dentro de la región de no rechazo. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarTTestFusarium413.R}{(Script)}}{figure.4.13}{}}
