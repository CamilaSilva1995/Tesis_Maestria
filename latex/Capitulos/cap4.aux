\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Valores del índice de Shannon de la comunidad completa ordenados por rango, coloreados por grupo. Los grupos aparecen mezclados en todo el recorrido. Prueba de Wilcoxon-Mann-Whitney: $W = 376$, $p = 0.259$. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarWilcoxonShannon415.R}{(Script: \texttt  {20260919\_RegenerarWilcoxonShannon415.R})}}}{77}{figure.4.15}\protected@file@percent }
\newlabel{fig:wilcoxon}{{4.15}{77}{Valores del índice de Shannon de la comunidad completa ordenados por rango, coloreados por grupo. Los grupos aparecen mezclados en todo el recorrido. Prueba de Wilcoxon-Mann-Whitney: $W = 376$, $p = 0.259$. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20260919_RegenerarWilcoxonShannon415.R}{(Script: \texttt {20260919\_RegenerarWilcoxonShannon415.R})}}{figure.4.15}{}}
