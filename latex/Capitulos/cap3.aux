\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.2}Diversidad alfa}{50}{subsection.3.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Conjunto complementario de cinco categorías, 80 muestras. A) Lecturas clasificadas por muestra, agrupadas por categoría: los suelos no cultivados tienen mayor profundidad que las muestras de cultivo. B) Diversidad alfa por categoría, con el valor $p$ de la prueba de Kruskal-Wallis en cada índice. Solo Shannon difiere globalmente, sin diferencias por pares tras la corrección por comparaciones múltiples. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarComplementarios34.R}{(Script: \texttt  {20261002\_RegenerarComplementarios34.R})}}}{51}{figure.3.4}\protected@file@percent }
\newlabel{fig:comp-alfa}{{3.4}{51}{Conjunto complementario de cinco categorías, 80 muestras. A) Lecturas clasificadas por muestra, agrupadas por categoría: los suelos no cultivados tienen mayor profundidad que las muestras de cultivo. B) Diversidad alfa por categoría, con el valor $p$ de la prueba de Kruskal-Wallis en cada índice. Solo Shannon difiere globalmente, sin diferencias por pares tras la corrección por comparaciones múltiples. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarComplementarios34.R}{(Script: \texttt {20261002\_RegenerarComplementarios34.R})}}{figure.3.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.3}Composición y diversidad beta}{51}{subsection.3.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Composición y diversidad beta del conjunto de cinco categorías. A) Abundancia relativa de los ocho filos más abundantes por muestra, agrupadas por categoría. B) Ordenación NMDS de la disimilitud de Bray-Curtis entre las 80 muestras, con el centroide de cada categoría (rombos). Las dos clases de cultivo se superponen entre sí y se separan de los suelos no cultivados. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarComplementarios35.R}{(Script: \texttt  {20261002\_RegenerarComplementarios35.R})}}}{53}{figure.3.5}\protected@file@percent }
\newlabel{fig:comp-beta}{{3.5}{53}{Composición y diversidad beta del conjunto de cinco categorías. A) Abundancia relativa de los ocho filos más abundantes por muestra, agrupadas por categoría. B) Ordenación NMDS de la disimilitud de Bray-Curtis entre las 80 muestras, con el centroide de cada categoría (rombos). Las dos clases de cultivo se superponen entre sí y se separan de los suelos no cultivados. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarComplementarios35.R}{(Script: \texttt {20261002\_RegenerarComplementarios35.R})}}{figure.3.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.3}{\ignorespaces PERMANOVA por pares entre las cinco categorías sobre la disimilitud de Bray-Curtis, con 999 permutaciones y valores $p$ ajustados por Benjamini-Hochberg. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarComplementarios35.R}{(Script: \texttt  {20261002\_RegenerarComplementarios35.R})}}}{54}{table.3.3}\protected@file@percent }
\newlabel{tab:comp-pares}{{3.3}{54}{PERMANOVA por pares entre las cinco categorías sobre la disimilitud de Bray-Curtis, con 999 permutaciones y valores $p$ ajustados por Benjamini-Hochberg. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarComplementarios35.R}{(Script: \texttt {20261002\_RegenerarComplementarios35.R})}}{table.3.3}{}}
