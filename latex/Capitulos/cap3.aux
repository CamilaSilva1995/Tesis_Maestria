\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Redes de muestras construidas con la disimilitud de Jaccard cuantitativa. Cada nodo es una muestra, coloreada por tratamiento, y cada arista une dos muestras cuya disimilitud no supera el umbral. A) Umbral $d \leq 0.16$, que conserva el 25\% de los pares más parecidos: 39 muestras conectadas y 338 aristas. B) Umbral $d \leq 0.13$, el 10\% de los pares: 30 muestras y 113 aristas; el grosor de la arista indica la distancia. En ninguna de las dos los colores se separan. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesMuestras32.R}{(Script: \texttt  {20261002\_RegenerarRedesMuestras32.R})}}}{43}{figure.3.2}\protected@file@percent }
\newlabel{fig:redes-muestras}{{3.2}{43}{Redes de muestras construidas con la disimilitud de Jaccard cuantitativa. Cada nodo es una muestra, coloreada por tratamiento, y cada arista une dos muestras cuya disimilitud no supera el umbral. A) Umbral $d \leq 0.16$, que conserva el 25\% de los pares más parecidos: 39 muestras conectadas y 338 aristas. B) Umbral $d \leq 0.13$, el 10\% de los pares: 30 muestras y 113 aristas; el grosor de la arista indica la distancia. En ninguna de las dos los colores se separan. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesMuestras32.R}{(Script: \texttt {20261002\_RegenerarRedesMuestras32.R})}}{figure.3.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.2}Redes de coocurrencia}{44}{subsection.3.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Redes de coocurrencia entre taxones. A) Componente gigante de la red de géneros con correlación SparCC $|r| \geq 0.8$: 482 géneros y 7~395 aristas; el color indica el filo y el tamaño el número de vecinos. Los grupos de Actinobacteria, Proteobacteria y Planctomycetes forman módulos casi separados. \textit  {Fusarium} no tiene vecinos a este umbral. B) Vecindario de \textit  {Fusarium} con $|r| \geq 0.5$: sus 40 géneros más correlacionados, con los seis mayores etiquetados; la correlación máxima es 0.63. C) Vecinos de \textit  {Fusarium} según Alnitak sobre la tabla completa, con la correlación de Spearman $\rho $ y la disimilitud de Bray-Curtis $d$ de cada par. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt  {20261002\_RegenerarRedesCoocurrencia33.R})}}}{45}{figure.3.3}\protected@file@percent }
\newlabel{fig:redes-coocurrencia}{{3.3}{45}{Redes de coocurrencia entre taxones. A) Componente gigante de la red de géneros con correlación SparCC $|r| \geq 0.8$: 482 géneros y 7~395 aristas; el color indica el filo y el tamaño el número de vecinos. Los grupos de Actinobacteria, Proteobacteria y Planctomycetes forman módulos casi separados. \textit {Fusarium} no tiene vecinos a este umbral. B) Vecindario de \textit {Fusarium} con $|r| \geq 0.5$: sus 40 géneros más correlacionados, con los seis mayores etiquetados; la correlación máxima es 0.63. C) Vecinos de \textit {Fusarium} según Alnitak sobre la tabla completa, con la correlación de Spearman $\rho $ y la disimilitud de Bray-Curtis $d$ de cada par. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt {20261002\_RegenerarRedesCoocurrencia33.R})}}{figure.3.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.2}{\ignorespaces Métricas de la red de coocurrencia SparCC entre géneros según el umbral de correlación. ``Neg.'' es el número de aristas con correlación negativa, ``Gigante'' el tamaño del componente gigante, ``Agrup.'' el coeficiente de agrupamiento y la modularidad se calcula con el método de Louvain; el grado de \textit  {Fusarium} es su número de vecinos. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt  {20261002\_RegenerarRedesCoocurrencia33.R})}}}{46}{table.3.2}\protected@file@percent }
\newlabel{tab:redes-metricas}{{3.2}{46}{Métricas de la red de coocurrencia SparCC entre géneros según el umbral de correlación. ``Neg.'' es el número de aristas con correlación negativa, ``Gigante'' el tamaño del componente gigante, ``Agrup.'' el coeficiente de agrupamiento y la modularidad se calcula con el método de Louvain; el grado de \textit {Fusarium} es su número de vecinos. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt {20261002\_RegenerarRedesCoocurrencia33.R})}}{table.3.2}{}}
