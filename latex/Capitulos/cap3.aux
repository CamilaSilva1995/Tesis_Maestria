\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.2}Redes de coocurrencia}{45}{subsection.3.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Redes de coocurrencia entre taxones. A) Componente gigante de la red de géneros con correlación SparCC $|r| \geq 0.8$: 482 géneros y 7~395 aristas; el color indica el filo y el tamaño el número de vecinos. Los grupos de Actinobacteria, Proteobacteria y Planctomycetes forman módulos casi separados. \textit  {Fusarium} no tiene vecinos a este umbral. B) Vecindario de \textit  {Fusarium} con $|r| \geq 0.5$: sus 40 géneros más correlacionados, con los seis mayores etiquetados; la correlación máxima es 0.63. C) Vecinos de \textit  {Fusarium} según Alnitak sobre la tabla completa, con la correlación de Spearman $\rho $ y la disimilitud de Bray-Curtis $d$ de cada par. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt  {20261002\_RegenerarRedesCoocurrencia33.R})}}}{47}{figure.3.3}\protected@file@percent }
\newlabel{fig:redes-coocurrencia}{{3.3}{47}{Redes de coocurrencia entre taxones. A) Componente gigante de la red de géneros con correlación SparCC $|r| \geq 0.8$: 482 géneros y 7~395 aristas; el color indica el filo y el tamaño el número de vecinos. Los grupos de Actinobacteria, Proteobacteria y Planctomycetes forman módulos casi separados. \textit {Fusarium} no tiene vecinos a este umbral. B) Vecindario de \textit {Fusarium} con $|r| \geq 0.5$: sus 40 géneros más correlacionados, con los seis mayores etiquetados; la correlación máxima es 0.63. C) Vecinos de \textit {Fusarium} según Alnitak sobre la tabla completa, con la correlación de Spearman $\rho $ y la disimilitud de Bray-Curtis $d$ de cada par. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt {20261002\_RegenerarRedesCoocurrencia33.R})}}{figure.3.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.2}{\ignorespaces Métricas de la red de coocurrencia SparCC entre géneros según el umbral de correlación. ``Neg.'' es el número de aristas con correlación negativa, ``Gigante'' el tamaño del componente gigante, ``Agrup.'' el coeficiente de agrupamiento y la modularidad se calcula con el método de Louvain; el grado de \textit  {Fusarium} es su número de vecinos. \href  {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt  {20261002\_RegenerarRedesCoocurrencia33.R})}}}{48}{table.3.2}\protected@file@percent }
\newlabel{tab:redes-metricas}{{3.2}{48}{Métricas de la red de coocurrencia SparCC entre géneros según el umbral de correlación. ``Neg.'' es el número de aristas con correlación negativa, ``Gigante'' el tamaño del componente gigante, ``Agrup.'' el coeficiente de agrupamiento y la modularidad se calcula con el método de Louvain; el grado de \textit {Fusarium} es su número de vecinos. \href {https://github.com/CamilaSilva1995/Tesis_Maestria/blob/main/Analisis_Comparativo/Fresa_Solena/20261002_RegenerarRedesCoocurrencia33.R}{(Script: \texttt {20261002\_RegenerarRedesCoocurrencia33.R})}}{table.3.2}{}}
